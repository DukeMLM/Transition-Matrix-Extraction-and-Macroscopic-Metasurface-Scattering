__pycache__/
*.pyc

# packaging and test-runner artifacts
*.egg-info/
build/
dist/
.pytest_cache/

# CST run directories (project folders are 30-100 MB each); curated
# artifacts from them are force-added explicitly
aggregation/cst_direct/run_*/
# CST working directories: opening a packed *.cst unpacks a same-named folder
# next to it (Model/, Result/, ModelCache/ ...). The packed archive is what we
# track; cst_packed_reference.py reads it directly.
test/*/*/

# CST supercell benchmark (aggregation/cst_supercell/).  These projects were
# built by build_2x2_supercell.py rather than shipped, so the *.cst headers are
# tracked together with the model history, the solver log and design.json --
# enough to see and re-create exactly what was solved -- while the working
# directory itself (2.4 GB of field sets, solution coefficients and port-mode
# files) is not.  The physics that came out of them lives in the tracked
# cst_direct_supercell*.csv.
aggregation/cst_supercell/runs*/*/*/*
!aggregation/cst_supercell/runs*/*/*/Model/
!aggregation/cst_supercell/runs*/*/*/Result/
aggregation/cst_supercell/runs*/*/*/Model/*
!aggregation/cst_supercell/runs*/*/*/Model/3D/
aggregation/cst_supercell/runs*/*/*/Model/3D/*
!aggregation/cst_supercell/runs*/*/*/Model/3D/ModelHistory.json
aggregation/cst_supercell/runs*/*/*/Result/*
!aggregation/cst_supercell/runs*/*/*/Result/Model.log

# Aggregated finite-cluster T-matrices: (n_freq, D_C, D_C) complex, tens of MB,
# incompressible, and regenerated by `run_supercell.py --cluster-lmax N`.
cluster_T.npz

# The Floquet-to-T retrieval trail lives on the Fast-T-Matrix-Trail branch and
# is not tracked here.  A checkout that has been on that branch still holds its
# local run tree (unpacked CST databases, generated products); ignore it so
# `git status` on dary stays about the aggregation study.
retrieval/
